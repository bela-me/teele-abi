{
  "name": "teele-abi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && npm run seed && next start -H 0.0.0.0",
    "seed": "prisma db seed",
    "lint": "eslint .",
    "test": "tsx --test \"lib/**/*.test.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "csv-parse": "7.0.3",
    "next": "16.4.3",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
